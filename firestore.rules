rules_version = '2';
// Auto Ping Pong: one save doc per Google player (autopets/{uid}); only that player may read or write it.
// Published by hand in the Firebase console (project auto-ping-pong-b04bd).
service cloud.firestore {
  match /databases/{database}/documents {
    match /autopets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['name', 'run', 'games', 'champs', 'best', 'at'])
        && request.resource.data.run is string && request.resource.data.run.size() <= 100000
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }
    // 랭킹: 끝난 판마다 한 줄. 로그인한 사람은 모두 읽고, 본인 기록만 새로 쓸 수 있고, 고치거나 지울 수 없다.
    match /autopets_rank/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'diff', 'result', 'wins', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.diff in ['easy', 'hard', 'extreme', 'ultra']
        && request.resource.data.result in ['win', 'lose']
        && request.resource.data.wins is int && request.resource.data.wins >= 0 && request.resource.data.wins <= 10
        && request.resource.data.at == request.time;
    }
  }
}
